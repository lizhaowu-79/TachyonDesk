<Project>
  <PropertyGroup>
    <TachyonBuildRoot Condition="'$(TachyonBuildRoot)' == ''">$(MSBuildThisFileDirectory)build\</TachyonBuildRoot>
    <TachyonDependencyRoot>$(MSBuildThisFileDirectory)3rdparty\x64-windows\</TachyonDependencyRoot>
    <TachyonSodiumRoot>$(MSBuildThisFileDirectory)3rdparty\libsodium-1.0.22-stable\libsodium\</TachyonSodiumRoot>
    <ForceImportBeforeCppTargets>$(MSBuildThisFileDirectory)BuildOutput.targets</ForceImportBeforeCppTargets>
  </PropertyGroup>
</Project>
